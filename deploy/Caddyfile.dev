# The composed shared origin on :5318: backend paths and mutations go to
# the API container, page GETs to the SvelteKit node server. Keep the path
# list in sync with frontend/proxy-paths.ts and deploy/Caddyfile. The
# websocket (/app/<key>) is served here too; production also has its own
# host for it.

# The portal's https preview (https://telescope.test) proxies from this
# host; its X-Forwarded-Proto passes through.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:5318 {
	encode zstd gzip
	# The security headers production sends too.
	header {
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options nosniff
	}
	request_body {
		max_size 8MB
	}

	@axum {
		path /api/* /up /eve /sanctum/* /storage/* /broadcasting/auth /app/*
	}
	reverse_proxy @axum api:3000

	@mutation {
		not method GET HEAD
	}
	reverse_proxy @mutation api:3000

	reverse_proxy frontend:3000
}
