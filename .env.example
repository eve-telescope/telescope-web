# Copy to .env. Everything has a working local default; production needs
# DATABASE_URL, the EVE application and PUSHER_APP_SECRET.

# Postgres (the docker-compose instance) and the API listen address.
# DATABASE_URL=postgres://telescope:telescope@127.0.0.1:5448/telescope
# BIND_ADDR=127.0.0.1:3000
# RUST_LOG=info

# The site's own URL: share links and pagination links.
# APP_URL=https://eve-telescope.com
# APP_NAME=Telescope

# The EVE SSO application (developers.eveonline.com). Its callback is
# registered with CCP and must match EVE_CALLBACK.
# EVE_CLIENT_ID=
# EVE_CLIENT_SECRET=
# EVE_CALLBACK=https://eve-telescope.com/eve/callback

# The Pusher protocol websocket (ws.eve-telescope.com/app/<key>). The key
# is baked into every desktop client and must not change; the secret
# signs channel subscriptions and is only known to this server, so it can
# be rotated freely (a random one is used when unset).
# PUSHER_APP_ID=telescope
# PUSHER_APP_KEY=04pcwy13bvcyjoio6mf6
# PUSHER_APP_SECRET=
# Seconds a client may stay silent (announced on connect), seconds of
# silence before the server pings, and the largest client message.
# PUSHER_ACTIVITY_TIMEOUT=30
# PUSHER_PING_INTERVAL=60
# PUSHER_MAX_MESSAGE_SIZE=10000

# The hourly tasks: affiliations from ESI, expired network access, shared
# scans older than SCAN_RETENTION_DAYS (0 keeps them forever).
# SCHEDULER_ENABLED=false
# SCAN_RETENTION_DAYS=7

# How long a website sign-in lasts.
# SESSION_LIFETIME_DAYS=30

# The one-click demo login at /demo-login, for local stacks only
# (docker-compose turns it on; seed the pilot with
# `docker compose run --rm demo-seed` or `cargo run --bin seed_demo`).
# DEMO_ENABLED=false
# DEMO_CHARACTER_ID=2100000001

# External services, for tests and local mocks.
# ESI_BASE_URL=https://esi.evetech.net
# SSO_BASE_URL=https://login.eveonline.com
# GITHUB_API_URL=https://api.github.com

# Tests only.
# TEST_DATABASE_URL=postgres://telescope:telescope@127.0.0.1:5448/telescope_test
